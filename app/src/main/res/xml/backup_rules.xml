<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 i starsze. Nagrania z sypialni nie mają czego szukać w kopii zapasowej —
  `allowBackup="false"` i tak to wyłącza, ale reguły są tu jawnie, żeby nie polegać
  na jednym atrybucie.
-->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>
